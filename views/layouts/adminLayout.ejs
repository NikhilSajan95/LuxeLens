<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta http-equiv="Cache-Control" content="no-cache, no-store, must-revalidate" />
  <meta http-equiv="Pragma" content="no-cache" />
  <meta http-equiv="Expires" content="0" />
  <title><%= title || 'Admin Panel' %></title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.6.2/cropper.min.css" />
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://unpkg.com/lucide@latest"></script>
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

</head>

<body class="bg-gray-100">
  <div class="flex min-h-screen">
    <!-- Sidebar -->
    <aside class="w-60 bg-white border-r h-screen flex flex-col justify-between shadow-sm">
      <div>
        <div class="flex items-center justify-center h-16 border-b font-bold text-xl">
          <i data-lucide="layout-dashboard" class="w-5 h-5 mr-2"></i> Admin
        </div>

        <nav class="p-4 space-y-2 text-sm">
          <a href="/admin/dashboard" class="flex items-center px-3 py-2 rounded hover:bg-gray-100">
            <i data-lucide="layout-dashboard" class="w-4 h-4 mr-2"></i> Dashboard
          </a>
          <a href="/admin/products" class="flex items-center px-3 py-2 rounded hover:bg-gray-100">
            <i data-lucide="box" class="w-4 h-4 mr-2"></i> Products
          </a>
          <a href="/admin/orders" class="flex items-center px-3 py-2 rounded hover:bg-gray-100">
            <i data-lucide="shopping-cart" class="w-4 h-4 mr-2"></i> Orders
          </a>
          <a href="/admin/customers" class="flex items-center px-3 py-2 rounded hover:bg-gray-100">
            <i data-lucide="users" class="w-4 h-4 mr-2"></i> Customers
          </a>
          <a href="#" class="flex items-center px-3 py-2 rounded hover:bg-gray-100">
            <i data-lucide="bar-chart" class="w-4 h-4 mr-2"></i> Report
          </a>
          <a href="#" class="flex items-center px-3 py-2 rounded hover:bg-gray-100">
            <i data-lucide="ticket" class="w-4 h-4 mr-2"></i> Coupons
          </a>
          <a href="/admin/Categories" class="flex items-center px-3 py-2 rounded hover:bg-gray-100">
            <i data-lucide="folder" class="w-4 h-4 mr-2"></i> Category
          </a>
          <a href="#" class="flex items-center px-3 py-2 rounded hover:bg-gray-100">
            <i data-lucide="image" class="w-4 h-4 mr-2"></i> Banner Management
          </a>
          <a href="#" class="flex items-center px-3 py-2 rounded hover:bg-gray-100">
            <i data-lucide="gift" class="w-4 h-4 mr-2"></i> Offer Management
          </a>
          <a href="/admin/brands" class="flex items-center px-3 py-2 rounded hover:bg-gray-100">
            <i data-lucide="tag" class="w-4 h-4 mr-2"></i> Brand Management
          </a>
        </nav>
      </div>

      <div class="p-4 space-y-2 text-sm">
        <a href="#" class="flex items-center px-3 py-2 rounded hover:bg-gray-100">
          <i data-lucide="settings" class="w-4 h-4 mr-2"></i> Settings
        </a>
        <a id="logoutBtn" class="flex items-center px-3 py-2 rounded hover:bg-gray-100 text-red-600 font-medium cursor-pointer">
          <i data-lucide="log-out" class="w-4 h-4 mr-2"></i> Logout
        </a>
      </div>
    </aside>

    <!-- Main content area -->
    <%- body %>
  </div>
<script src="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.6.2/cropper.min.js"></script>

  <script>

    document.getElementById('logoutBtn').addEventListener('click', async () => {

        try {
            const response = await fetch('/admin/logout', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                }
            });

            // 2. Parse the JSON response
            const data = await response.json();

            // 3. Handle success
            if (response.ok && data.success) {
                
                Swal.fire({
                title: "Success!",
                text: data.message,
                icon: "success",
                timer: 2000, // Auto-close after 2 seconds
                showConfirmButton: false
            });
                setTimeout(()=>{
                window.location.href = data.redirectUrl;
            },2000);
                
                
                
            } else {
                throw error
            }
        } catch (error) {
            console.error('An error occurred during logout:', error);
        }
    });

    lucide.createIcons(); 
    console.log("Flash Message from Server:", "<%= success_msg %>");
    // Check for success flash message
        <% if (success_msg && success_msg.length > 0) { %>

            Swal.fire({
                title: "Success!",
                text: "<%= success_msg[0] %>",
                icon: "success",
                timer: 2000, 
                showConfirmButton: false
            });
        <% } %>

        // Check for error flash message
        <% if (error_msg && error_msg.length > 0) { %>
            Swal.fire({
                title: "Error!",
                text: "<%= error_msg[0] %>",
                icon: "error"
            });
        <% } %>
  </script>
</body>
</html>