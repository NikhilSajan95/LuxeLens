<main class="flex-1 p-6">
  <h1 class="text-2xl font-semibold mb-4">Customer Management</h1>

  <!-- 🔍 Search Form -->
  <form method="GET" class="mb-6 flex gap-2">
    <input
      type="text"
      name="search"
      placeholder="Search customers..."
      value="<%= search %>"
      class="px-4 py-2 border border-gray-300 rounded w-full"
    />
    <button type="submit" class="px-4 py-2 bg-blue-600 text-white rounded hover:bg-blue-700">Search</button>
    <% if (search) { %>
      <a href="/admin/customers" class="px-4 py-2 bg-gray-300 text-gray-800 rounded hover:bg-gray-400">Clear</a>
    <% } %>
  </form>

  <!-- 📋 Customer Table -->
  <table class="min-w-full bg-white rounded shadow overflow-hidden">
    <thead class="bg-gray-200">
      <tr>
        <th class="py-3 px-4 text-left">S.No</th>
        <th class="py-3 px-4 text-left">Name</th>
        <th class="py-3 px-4 text-left">Email</th>
        <th class="py-3 px-4 text-left">Status</th>
        <th class="py-3 px-4 text-left">Actions</th>
      </tr>
    </thead>
    <tbody class="text-gray-700">
      <% if (users.length === 0) { %>
        <tr>
          <td colspan="5" class="text-center py-4 text-gray-500">No customers found.</td>
        </tr>
      <% } else { %>
        <% users.forEach((user, index) => { %>
          <tr class="border-b hover:bg-gray-100">
            <td class="py-2 px-4"><%= (currentPage - 1) * 10 + index + 1 %></td>
            <td class="py-2 px-4"><%= user.name %></td>
            <td class="py-2 px-4"><%= user.email %></td>
            <td class="py-2 px-4">
              <span id="status-badge-<%= user._id %>" class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full <%= user.is_active ? 'bg-green-100 text-green-800' : 'bg-red-100 text-red-800' %>">
                <%= user.is_active ? 'Active' : 'Blocked' %>
              </span>
            </td>            
            <td class="py-2 px-4">
            <button 
              class="toggle-block-btn text-<%= user.is_active ? 'red' : 'green' %>-600 hover:underline font-medium"
              data-user-id="<%= user._id %>"
              data-is-active="<%= user.is_active %>"
            >
              <%= user.is_active ? 'Block' : 'Unblock' %>
            </button>
          </td>
          </tr>
        <% }) %>
      <% } %>
    </tbody>
  </table>

  <!-- 📄 Pagination -->
  <% if (totalPages > 1) { %>
    <div class="mt-6 flex justify-center space-x-2">
      <% for (let i = 1; i <= totalPages; i++) { %>
        <a href="?page=<%= i %><%= search ? `&search=${search}` : '' %>"
           class="px-3 py-1 rounded <%= currentPage === i ? 'bg-blue-600 text-white' : 'bg-gray-200 hover:bg-gray-300' %>">
          <%= i %>
        </a>
      <% } %>
    </div>
  <% } %>
</main>

<script>
  lucide.createIcons(); // Ensure icons are initialized

  
  const toggleButtons = document.querySelectorAll('.toggle-block-btn'); // Select all toggle buttons on the page

  toggleButtons.forEach(button => {
    button.addEventListener('click', async function() {
      // Get data from the button's attributes
      const userId = this.getAttribute('data-user-id');
      const isActive = this.getAttribute('data-is-active') === 'true'; // Convert string to boolean
      const actionText = isActive ? 'block' : 'unblock';


      const result = await Swal.fire({
        title: 'Are you sure?',
        text: `Do you want to ${actionText} this user?`,
        icon: 'warning',
        showCancelButton: true,
        confirmButtonColor: isActive ? '#d33' : '#10b981', 
        cancelButtonColor: '#6b7280',
        confirmButtonText: `Yes, ${actionText} them!`
      });


      if (result.isConfirmed) {
        try {

          const response = await fetch(`/admin/customers/${userId}`, {
            method: 'PATCH',
            headers: {
              'Content-Type': 'application/json'
            }
          });

          const data = await response.json();

          if (response.ok && data.success) {
  
            Swal.fire({
              title: 'Success!',
              text: data.message,
              icon: 'success',
              timer: 1500,
              showConfirmButton: false
            });

            const newStatus = data.is_active;
            
            // Update the button attributes and text
            this.setAttribute('data-is-active', newStatus);
            this.textContent = newStatus ? 'Block' : 'Unblock';
            this.className = `toggle-block-btn text-${newStatus ? 'red' : 'green'}-600 hover:underline font-medium`;

            // Update the status badge
            const badge = document.getElementById(`status-badge-${userId}`);
            badge.textContent = newStatus ? 'Active' : 'Blocked';
            badge.className = `px-2 inline-flex text-xs leading-5 font-semibold rounded-full ${newStatus ? 'bg-green-100 text-green-800' : 'bg-red-100 text-red-800'}`;

          } else {
            throw new Error(data.message || 'Failed to update user status');
          }
        } catch (error) {
          console.error('Error:', error);
          Swal.fire({
            title: 'Error!',
            text: error.message,
            icon: 'error'
          });
        }
      }
    });
  });
</script>