<main class="flex-1 p-6">
  <div class="flex justify-between items-center mb-6">
    <h1 class="text-2xl font-semibold">Category Management</h1>
    <button onclick="document.getElementById('addCategoryModal').classList.remove('hidden')" class="px-4 py-2 bg-blue-600 text-white rounded hover:bg-blue-700">
      + Add Category
    </button>
  </div>

  <form method="GET" class="mb-6 flex gap-2">
    <input
      type="text"
      name="search"
      placeholder="Search categories..."
      value="<%= search %>"
      class="px-4 py-2 border border-gray-300 rounded w-full"
    />
    <button type="submit" class="px-4 py-2 bg-blue-600 text-white rounded hover:bg-blue-700">Search</button>
    <% if (search) { %>
      <a href="/admin/categories" class="px-4 py-2 bg-gray-300 text-gray-800 rounded hover:bg-gray-400">Clear</a>
    <% } %>
  </form>

  <table class="min-w-full bg-white rounded shadow overflow-hidden">
    <thead class="bg-gray-200">
      <tr>
        <th class="py-3 px-4 text-left">S.No</th>
        <th class="py-3 px-4 text-left">Name</th>
        <th class="py-3 px-4 text-left">Status</th>
        <th class="py-3 px-4 text-left">Actions</th>
      </tr>
    </thead>
    <tbody class="text-gray-700">
      <% if (categories.length === 0) { %>
        <tr>
          <td colspan="4" class="text-center py-4 text-gray-500">No categories found.</td>
        </tr>
      <% } else { %>
        <% categories.forEach((category, index) => { %>
          <tr class="border-b hover:bg-gray-100">
            <td class="py-2 px-4"><%= (currentPage - 1) * 10 + index + 1 %></td>
            <td class="py-2 px-4"><%= category.name %></td>
            <td class="py-2 px-4">
              <span class="px-3 py-1 text-xs font-medium rounded-full text-white
                <%= category.isListed ? 'bg-green-500' : 'bg-gray-400' %>">
                <%= category.isListed ? 'Listed' : 'Unlisted' %>
              </span>
            </td>
            <td class="py-2 px-4 space-x-2 whitespace-nowrap">
              <button onclick="openEditModal('<%= category._id %>', `<%= category.name %>`)" class="text-blue-600 hover:underline inline-flex items-center">
              <i data-lucide="edit" class="w-4 h-4"></i>
              </button>
              <form action="/admin/categories/<%= category._id %>" method="POST" class="inline" onsubmit="confirmDelete(event, this)">
                <button type="submit" class="text-red-600 hover:underline inline-flex items-center">
                  <i data-lucide="trash-2" class="w-4 h-4"></i>
                </button>
              </form>
              <form action="/admin/categories/<%= category._id %>" method="POST" class="inline" onsubmit="handleToggle(event, this)">
                <button type="submit" class="hover:underline inline-flex items-center
                  <%= category.isListed ? 'text-gray-500' : 'text-green-600' %>">
                  <i data-lucide="<%= category.isListed ? 'eye-off' : 'eye' %>" class="w-4 h-4"></i>
                </button>
              </form>
            </td>
          </tr>
        <% }) %>
      <% } %>
    </tbody>
  </table>

  <% if (totalPages > 1) { %>
    <div class="mt-6 flex justify-center space-x-2">
      <% for (let i = 1; i <= totalPages; i++) { %>
        <a href="?page=<%= i %><%= search ? `&search=${search}` : '' %>"
           class="px-3 py-1 rounded <%= currentPage === i ? 'bg-blue-600 text-white' : 'bg-gray-200 hover:bg-gray-300' %>">
          <%= i %>
        </a>
      <% } %>
    </div>
  <% } %>

  <div id="addCategoryModal" class="fixed inset-0 flex items-center justify-center bg-black bg-opacity-50 z-50 hidden">
    <div class="bg-white p-6 rounded-lg shadow-lg w-full max-w-md mx-auto">
      <h2 class="text-lg font-semibold mb-4">Add Category</h2>
      <form  id="addCategoryForm" onsubmit="submitAddForm(event)" novalidate>
        <label for="add_category_name" class="block text-sm font-medium text-gray-700 mb-1">Category Name</label>
        <input id="add_category_name" type="text" name="name" placeholder="Category Name" class="w-full px-4 py-2 border border-gray-300 rounded mb-2" required>
        <span id="add_category_error" class="text-red-500 text-sm mb-4"></span>
        <div class="flex justify-end space-x-2">
          <button type="button" onclick="document.getElementById('addCategoryModal').classList.add('hidden')" class="px-4 py-2 bg-gray-300 text-gray-800 rounded hover:bg-gray-400">Cancel</button>
          <button type="submit" class="px-4 py-2 bg-blue-600 text-white rounded hover:bg-blue-700">Add</button>
        </div>
      </form>
    </div>
  </div>

  <div id="editCategoryModal" class="fixed inset-0 flex items-center justify-center bg-black bg-opacity-50 z-50 hidden">
  <div class="bg-white p-6 rounded-lg shadow-lg w-full max-w-md mx-auto">
    <h2 class="text-lg font-semibold mb-4">Edit Category</h2>
    <form  id="editCategoryForm" onsubmit="submitEditForm(event)" novalidate>
      <input type="hidden" id="edit_category_id" name="id">
      <label for="edit_category_name" class="block text-sm font-medium text-gray-700 mb-1">Category Name</label>
      <input id="edit_category_name" type="text" name="name" placeholder="Category Name" class="w-full px-4 py-2 border border-gray-300 rounded mb-2" required>
      <span id="edit_category_error" class="text-red-500 text-sm mb-4"></span>
      <div class="flex justify-end space-x-2">
        <button type="button" onclick="document.getElementById('editCategoryModal').classList.add('hidden')" class="px-4 py-2 bg-gray-300 text-gray-800 rounded hover:bg-gray-400">Cancel</button>
        <button type="submit" class="px-4 py-2 bg-blue-600 text-white rounded hover:bg-blue-700">Update</button>
      </div>
    </form>
  </div>
</div>

  <script>

    function submitAddForm(event) {
      event.preventDefault();
      document.getElementById('add_category_error').textContent = '';
      const form = document.getElementById('addCategoryForm');
      const nameInput = form.querySelector('[name="name"]');
      nameInput.textContent = ''
      
      // Client-side validation
      if (nameInput.value.trim().length < 2 || nameInput.value.trim().length > 10) {
          document.getElementById('add_category_error').textContent = 'Category name must be minimum of 2 and maximum of 10 characters.';
          return;
      }
      
      const formData = new FormData(form);
      const submitButton = form.querySelector('button[type="submit"]');
      submitButton.disabled = true;

      fetch('/admin/categories', {
        method: 'POST',
        body: formData, // Use URLSearchParams for simple forms
        headers: {
          'Accept': 'application/json'
        }
      })
      .then(response => response.json())
      .then(data => {
        if (data.success) {
          document.getElementById('addCategoryModal').classList.add('hidden');
          Swal.fire('Success!', data.message, 'success')
            .then(() => window.location.reload());
        } else {
          // Show backend error (e.g., "duplicate name")
          document.getElementById('add_category_error').textContent = data.message;
        }
      })
      .catch(error => {
        console.error('Error:', error);
        Swal.fire('Error!', 'An unexpected error occurred.', 'error');
      })
      .finally(() => {
          submitButton.disabled = false;
      });
    }

    function openEditModal(id, name) {
      // Clear any old errors
      document.getElementById('edit_category_error').textContent = '';

      const modal = document.getElementById('editCategoryModal');
      const form = document.getElementById('editCategoryForm');
      
      // Set the category's current name in the input
      form.querySelector('#edit_category_name').value = name;
      
      // Set the form's action URL to include the ID
      form.action = `/admin/categories/${id}`;
      
      modal.classList.remove('hidden');
  }

  // --- ADD THIS FUNCTION ---
  function submitEditForm(event) {
      event.preventDefault();
      const form = document.getElementById('editCategoryForm');
      const nameInput = form.querySelector('[name="name"]');
      const errorSpan = document.getElementById('edit_category_error');
      
      // Client-side validation
      if (nameInput.value.trim().length < 2 || nameInput.value.trim().length > 10) {
          errorSpan.textContent = 'Category name must be minimum of 2 and maximum of 10 characters.';
          return;
      }
      
      const formData = new FormData(form);
      const url = form.action; // Get the URL we set in openEditModal
      const submitButton = form.querySelector('button[type="submit"]');
      submitButton.disabled = true;

      fetch(url, {
        method: 'PUT',
        body: formData,
        headers: {
          'Accept': 'application/json'
        }
      })
      .then(response => response.json())
      .then(data => {
        if (data.success) {
          document.getElementById('editCategoryModal').classList.add('hidden');
          Swal.fire('Success!', data.message, 'success')
            .then(() => window.location.reload());
        } else {
          // Show backend error (e.g., "duplicate name")
          errorSpan.textContent = data.message;
        }
      })
      .catch(error => {
        console.error('Error:', error);
        Swal.fire('Error!', 'An unexpected error occurred.', 'error');
      })
      .finally(() => {
          submitButton.disabled = false;
      });
  }

    function confirmDelete(event, form) {
        event.preventDefault();
        const url = form.action;
        Swal.fire({
            title: 'Are you sure?',
            text: "You won't be able to revert this!",
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#d33',
            confirmButtonText: 'Yes, delete it!'
        }).then((result) => {
            if (result.isConfirmed) {
                fetch(url, { 
                method: 'DELETE',
                  headers: {
                    'Accept': 'application/json'
                  }
                 })
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        Swal.fire('Deleted!', data.message, 'success')
                            .then(() => window.location.reload());
                    } else {
                        Swal.fire('Error!', data.message, 'error');
                    }
                })
                .catch(err => Swal.fire('Error!', 'An unexpected error occurred.', 'error'));
            }
        });
    }

    function handleToggle(event, form) {
        event.preventDefault();
        const url = form.action;
        fetch(url, { 
          method: 'PATCH',
          headers: {
          'Accept': 'application/json'
        }
         })
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                Swal.fire('Updated!', data.message, 'success')
                    .then(() => window.location.reload());
            } else {
                Swal.fire('Error!', data.message, 'error');
            }
        })
        .catch(err => Swal.fire('Error!', 'An unexpected error occurred.', 'error'));
    }

    lucide.createIcons();
  </script>
</main>