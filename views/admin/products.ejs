// Replace your old previewVariantImages function with this corrected one
function previewVariantImages(event, index, mode) {
    // This logic now correctly finds the preview div for BOTH modals
    let previewId;
    if (mode === 'add') {
        previewId = `addVariantPreview${index}`;
    } else { // mode === 'edit'
        previewId = `editVariantPreview_New${index}`;
    }

    const preview = document.getElementById(previewId);

    // If the preview div doesn't exist, log an error and stop
    if (!preview) {
        console.error(`Preview container with ID '${previewId}' not found.`);
        return;
    }

    preview.innerHTML = ''; // Clear existing previews
    const files = event.target.files;

    for (let i = 0; i < files.length; i++) {
        const file = files[i];
        if (file.type.startsWith('image/')) {
            const reader = new FileReader();
            
            reader.onload = function(e) {
                // Create a wrapper for the image and remove button
                const wrapper = document.createElement('div');
                wrapper.className = 'relative inline-block w-16 h-16 mr-2 mb-2';

                // Create the image
                const img = document.createElement('img');
                img.src = e.target.result;
                img.className = 'w-16 h-16 object-contain bg-gray-100 rounded';

                // Create the remove ('X') button
                const removeBtn = document.createElement('button');
                removeBtn.type = 'button';
                removeBtn.innerHTML = '&times;';
                removeBtn.className = 'absolute -top-1 -right-1 w-4 h-4 bg-red-600 text-white text-xs font-bold rounded-full flex items-center justify-center cursor-pointer';
                
                // Add the click event to call the removeImage function
                removeBtn.onclick = function(event) {
                    removeImage(event, index, i, mode);
                };

                // Add the image and button to the wrapper
                wrapper.appendChild(img);
                wrapper.appendChild(removeBtn);

                // Add the wrapper to the preview area
                preview.appendChild(wrapper);
            };
            
            reader.readAsDataURL(file);
        }
    }
}

