<div class="flex-1 p-6">

  <div class="flex justify-between items-center mb-6">
    <h1 class="text-2xl font-semibold">Product Management</h1>
    <button onclick="document.getElementById('addProductModal').classList.remove('hidden')" class="px-4 py-2 bg-blue-600 text-white rounded hover:bg-blue-700">
      + Add Product
    </button>
  </div>

  <form method="GET" class="mb-6 flex gap-2">
    <input type="text" name="search" placeholder="Search products..." value="<%= search %>" class="px-4 py-2 border border-gray-300 rounded w-full" />
    <button type="submit" class="px-4 py-2 bg-blue-600 text-white rounded hover:bg-blue-700">Search</button>
    <% if (search) { %>
      <a href="/admin/products" class="px-4 py-2 bg-gray-300 text-gray-800 rounded hover:bg-gray-400">Clear</a>
    <% } %>
  </form>

  <table class="min-w-full bg-white rounded shadow overflow-hidden">
    <thead class="bg-gray-200">
      <tr>
        <th class="py-4 px-3 text-center">S.No</th>
        <th class="py-4 px-3 text-center">Title</th>
        <th class="py-4 px-3 text-center">Category</th>
        <th class="py-4 px-3 text-center">Brand</th>
        <th class="py-4 px-3 text-center">Image</th>
        <th class="py-4 px-3 text-center">Variants</th>
        <th class="py-4 px-3 text-center">Regular Price</th>
        <th class="py-4 px-3 text-center">Offer Price</th>
        <th class="py-4 px-3 text-center">Stock Status</th>
        <th class="py-4 px-3 text-center">Status</th>
        <th class="py-4 px-3 text-center">Actions</th>
      </tr>
    </thead>
    <tbody class="text-gray-700">
      <% if (typeof products === 'undefined' || products.length === 0) { %>
        <tr>
          <td colspan="10" class="text-center py-4 text-gray-500">No products found.</td>
        </tr>
      <% } else { %>
        <% products.forEach((product, index) => { %>
          <tr class="border-b hover:bg-gray-100" data-product='<%- JSON.stringify(product).replace(/'/g, "&#39;") %>'>
            <td class="py-3 px-4"><%= (currentPage - 1) * 10 + index + 1 %></td>
            <td class="py-3 px-4"><%= product.title %></td>
            <td class="py-3 px-4"><%= product.category_id.name %></td>
            <td class="py-3 px-4"><%= product.brand_id.name %></td>
            <td class="py-3 px-4">
              <% if (product.variants && product.variants.length > 0 && product.variants[0].images && product.variants[0].images.length > 0) { %>
                <img src="<%= product.variants[0].images[0] %>" alt="<%= product.title %>" class="w-16 h-16 object-contain">
              <% } else { %>
                <span>No image</span>
              <% } %>
            </td>
            <td class="py-3 px-4 text-sm">
    <%
      // --- This logic groups the variants by color ---
      const variantsByColor = {};
      if (product.variants && product.variants.length > 0) {
        product.variants.forEach(variant => {
          if (!variantsByColor[variant.color]) {
            variantsByColor[variant.color] = [];
          }
          variantsByColor[variant.color].push(variant);
        });
      }
    %>

    <% if (Object.keys(variantsByColor).length > 0) { %>
        <ul class="list-none p-0 m-0">
          <% for (const color in variantsByColor) { %>
            <li class="mb-1">
              <strong class="font-medium"><%= color %>:</strong>
              
              <% variantsByColor[color].forEach((variant, index) => { %>
                <span class="ml-1">
                  <%= variant.size %> (<%= variant.quantity %>)
                  <%= index < variantsByColor[color].length - 1 ? ',' : '' %>
                </span>
              <% }) %>
            </li>
          <% } %>
        </ul>
    <% } else { %>
        <span class="text-gray-500">No variants</span>
    <% } %>
</td>
            <td class="py-3 px-4">₹<%= product.regular_price.toFixed(2) %></td>
            <td class="py-3 px-4">₹<%= product.offer_price ? product.offer_price.toFixed(2) : 'N/A' %></td>
            <td class="py-3 px-4"><%= product.stock_status %></td>
            <td class="py-3 px-4">
    <button onclick="handleToggle(event, '<%= product._id %>')"
        class="toggle-btn px-3 py-1 text-xs font-medium rounded-full text-white
        <%= product.isListed ? 'bg-green-500 hover:bg-green-600' : 'bg-gray-400 hover:bg-gray-500' %>">
        <%= product.isListed ? 'Listed' : 'Unlisted' %>
    </button>
</td>
            <td class="py-3 px-4 space-x-2 whitespace-nowrap">
              <button class="edit-btn text-blue-600 hover:underline" onclick="handleEditClick(event, this)">
                <i data-lucide="edit"></i>
              </button>
              <form action="/admin/products/<%= product._id %>" class="inline" onsubmit="confirmDelete(event, this)">
                <button type="submit" class="text-red-600 hover:underline">
                  <i data-lucide="trash"></i>
                </button>
              </form>
            </td>
          </tr>
        <% }) %>
      <% } %>
    </tbody>
  </table>

  <% if (typeof totalPages !== 'undefined' && totalPages > 1) { %>
    <div class="mt-6 flex justify-center space-x-2">
      <% for (let i = 1; i <= totalPages; i++) { %>
        <a href="?page=<%= i %><%= search ? `&search=${search}` : '' %>"
           class="px-3 py-1 rounded <%= currentPage === i ? 'bg-blue-600 text-white' : 'bg-gray-200 hover:bg-gray-300' %>">
          <%= i %>
        </a>
      <% } %>
    </div>
  <% } %>

  <div id="addProductModal" class="fixed inset-0 flex items-center justify-center bg-black bg-opacity-50 z-50 hidden">
    <div class="bg-white p-6 rounded-lg shadow-lg w-full max-w-2xl mx-auto overflow-y-auto max-h-[90vh]">
        <h2 class="text-lg font-semibold mb-4">Add Product</h2>
        <form action="/admin/products/add" method="POST" enctype="multipart/form-data" id="addProductForm" onsubmit="submitAddForm(event)" novalidate>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4">
                <div>
                    <label for="add_category_id" class="block text-sm font-medium text-gray-700 mb-1">Category</label>
                    <select id="add_category_id" name="category_id" class="w-full px-4 py-2 border border-gray-300 rounded" required>
                        <% if (typeof categories !== 'undefined' && categories.length > 0) { %>
                            <% categories.forEach(category => { %>
                                <option value="<%= category._id %>"><%= category.name %></option>
                            <% }) %>
                        <% } %>
                    </select>
                    <span id="add_category_id_error" class="text-red-500 text-sm mt-1"></span>
                </div>
                <div>
                    <label for="add_brand_id" class="block text-sm font-medium text-gray-700 mb-1">Brand</label>
                    <select id="add_brand_id" name="brand_id" class="w-full px-4 py-2 border border-gray-300 rounded" required>
                        <% if (typeof brands !== 'undefined' && brands.length > 0) { %>
                            <% brands.forEach(brand => { %>
                                <option value="<%= brand._id %>"><%= brand.name %></option>
                            <% }) %>
                        <% } %>
                    </select>
                    <span id="add_brand_id_error" class="text-red-500 text-sm mt-1"></span>
                </div>
                <div>
                    <label for="add_title" class="block text-sm font-medium text-gray-700 mb-1">Product Title</label>
                    <input id="add_title" type="text" name="title" placeholder="Product Title" class="w-full px-4 py-2 border border-gray-300 rounded" required>
                    <span id="add_title_error" class="text-red-500 text-sm mt-1"></span>
                </div>
                <div>
                    <label for="add_stock_status" class="block text-sm font-medium text-gray-700 mb-1">Stock Status</label>
                    <select id="add_stock_status" name="stock_status" class="w-full px-4 py-2 border border-gray-300 rounded" required>
                        <option value="in_stock">In Stock</option>
                        <option value="out_of_stock">Out of Stock</option>
                    </select>
                </div>
            </div>
            
            <div class="mb-4">
                <label for="add_description" class="block text-sm font-medium text-gray-700 mb-1">Description</label>
                <textarea id="add_description" name="description" placeholder="Description" class="w-full px-4 py-2 border border-gray-300 rounded"></textarea>
                <span id="add_description_error" class="text-red-500 text-sm mt-1"></span>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-4">
                <div>
                    <label for="add_regular_price" class="block text-sm font-medium text-gray-700 mb-1">Regular Price</label>
                    <input id="add_regular_price" type="number" name="regular_price" placeholder="Regular Price" step="0.01" class="w-full px-4 py-2 border border-gray-300 rounded" required>
                    <span id="add_regular_price_error" class="text-red-500 text-sm mt-1"></span>
                </div>
                <div>
                    <label for="add_offer_price" class="block text-sm font-medium text-gray-700 mb-1">Offer Price</label>
                    <input id="add_offer_price" type="number" name="offer_price" placeholder="Offer Price" step="0.01" class="w-full px-4 py-2 border border-gray-300 rounded">
                    <span id="add_offer_price_error" class="text-red-500 text-sm mt-1"></span>
                </div>
                <div>
                    <label for="add_warranty" class="block text-sm font-medium text-gray-700 mb-1">Warranty (months)</label>
                    <input id="add_warranty" type="number" name="warranty" placeholder="Warranty (months)" class="w-full px-4 py-2 border border-gray-300 rounded">
                    <span id="add_warranty_error" class="text-red-500 text-sm mt-1"></span>
                </div>
            </div>
            
            <label class="block text-sm font-medium text-gray-700 mb-2">Product Variants</label>
            <span id="add_variants_error" class="text-red-500 text-sm mt-1"></span>
            <div id="variantFields" class="mb-4 space-y-4">
                </div>
            
            <button type="button" onclick="addVariantField()" class="px-4 py-2 bg-gray-300 text-gray-800 rounded hover:bg-gray-400 mb-4">Add Variant</button>
            <div class="flex justify-end space-x-2">
                <button type="button" onclick="document.getElementById('addProductModal').classList.add('hidden')" class="px-4 py-2 bg-gray-300 text-gray-800 rounded hover:bg-gray-400">Cancel</button>
                <button type="submit" class="px-4 py-2 bg-blue-600 text-white rounded hover:bg-blue-700">Add</button>
            </div>
        </form>
    </div>
</div>

