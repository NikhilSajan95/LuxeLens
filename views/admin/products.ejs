// cropper js
// --- CROPPER LOGIC WITH APPENDING & QUEUE ---
let cropper;
let currentFileInput;
let currentVariantIndex;
let currentMode;

// Queue management for the CURRENT selection
let filesToCropQueue = [];
let originalFileCount = 0;

// NEW: An object to store the final list of cropped files for EACH variant
let finalFilesByVariant = {};

const imageToCrop = document.getElementById('imageToCrop');
const cropperModal = document.getElementById('cropperModal');
const cropperModalTitle = cropperModal.querySelector('h2');
const cropButton = document.getElementById('cropButton');

// This function is triggered when a user selects one or more files
function handleFileSelect(event, index, mode) {
    currentFileInput = event.target;
    currentVariantIndex = index;
    currentMode = mode;
    const files = event.target.files;

    if (files && files.length > 0) {
        // We only populate the temporary queue. We DON'T clear the final list.
        filesToCropQueue = Array.from(files);
        originalFileCount = files.length;
        
        processNextFileInQueue();
    }
}

// Processes the next file in the temporary queue
function processNextFileInQueue() {
    if (filesToCropQueue.length > 0) {
        const file = filesToCropQueue.shift();
        const reader = new FileReader();
        reader.onload = function(e) {
            const currentFileNumber = originalFileCount - filesToCropQueue.length;
            cropperModalTitle.textContent = `Crop Image (${currentFileNumber} of ${originalFileCount})`;
            imageToCrop.src = e.target.result;
            cropperModal.classList.remove('hidden');
            if (cropper) cropper.destroy();
            cropper = new Cropper(imageToCrop, {
                aspectRatio: NaN,
                viewMode: 1,
                background: false,
            });
        };
        reader.readAsDataURL(file);
    } else {
        // When the temporary queue is empty, finalize and update the display
        finalizeCroppedFiles();
    }
}

// Runs when the "Crop" button is clicked
function cropAndApply() {
    if (!cropper) return;
    const canvas = cropper.getCroppedCanvas({ width: 800, height: 800 });

    canvas.toBlob((blob) => {
        const fileName = `cropped_${Date.now()}.png`;
        const croppedFile = new File([blob], fileName, { type: "image/png" });
        
        // NEW: Add the cropped file to the PERSISTENT list for the current variant
        if (!finalFilesByVariant[currentVariantIndex]) {
            finalFilesByVariant[currentVariantIndex] = [];
        }
        finalFilesByVariant[currentVariantIndex].push(croppedFile);
        
        // Process the next image in the temporary queue
        processNextFileInQueue();

    }, 'image/png');
}

// Puts ALL cropped files for the current variant back into the file input
function finalizeCroppedFiles() {
    // Get the complete list of files for this variant
    const completeFileList = finalFilesByVariant[currentVariantIndex] || [];
    
    const dataTransfer = new DataTransfer();
    completeFileList.forEach(file => dataTransfer.items.add(file));
    currentFileInput.files = dataTransfer.files;

    // Update the preview with the complete list
    previewVariantImages({ target: currentFileInput }, currentVariantIndex, currentMode);
    
    // Hide modal and clean up
    cropperModal.classList.add('hidden');
    if (cropper) {
        cropper.destroy();
        cropper = null;
    }
}

// Updated cancel function to ONLY clear the temporary queue
function cancelCropping() {
    cropperModal.classList.add('hidden');
    if (cropper) {
        cropper.destroy();
        cropper = null;
    }
    // Only clear the queue of files currently being processed
    filesToCropQueue = [];
}

cropButton.addEventListener('click', cropAndApply);
// --- END CROPPER LOGIC ---



function removeImage(event, variantIndex, fileIndex, mode) {
    event.preventDefault(); // Stop any default button behavior
    
    // Check if the file list exists and remove the file at the specific index
    if (finalFilesByVariant[variantIndex] && finalFilesByVariant[variantIndex][fileIndex]) {
        // Remove the file from our persistent list
        finalFilesByVariant[variantIndex].splice(fileIndex, 1);

        // Reconstruct the correct fileInput ID based on the mode
        const fileInputId = (mode === 'add')
            ? `variantImages${variantIndex}`
            : `editVariantImages${variantIndex}`;
            
        const fileInput = document.getElementById(fileInputId);
        
        if (fileInput) {
            // Get the complete list of remaining files for this variant
            const remainingFiles = finalFilesByVariant[variantIndex] || [];

            // Create a new DataTransfer and FileList with the remaining files
            const dataTransfer = new DataTransfer();
            remainingFiles.forEach(file => dataTransfer.items.add(file));

            // Update the actual file input
            fileInput.files = dataTransfer.files;

            // Re-render the previews for this specific variant
            previewVariantImages({ target: fileInput }, variantIndex, mode);
        }
    }
}


