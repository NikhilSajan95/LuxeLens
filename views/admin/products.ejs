            <div class="flex justify-end space-x-2">
                <button type="button" class="cancel-btn px-4 py-2 bg-gray-300 text-gray-800 rounded hover:bg-gray-400" onclick="document.getElementById('editProductModal').classList.add('hidden')">Cancel</button>
