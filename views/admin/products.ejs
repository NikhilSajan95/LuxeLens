  <div id="cropperModal" class="fixed inset-0 flex items-center justify-center bg-black bg-opacity-75 z-[60] hidden">
    <div class="bg-white p-6 rounded-lg shadow-lg w-full max-w-lg mx-auto">
        <h2 class="text-xl font-semibold mb-4">Crop Image</h2>
        <div class="img-container max-h-[60vh] overflow-hidden">
            <img id="imageToCrop" src="" alt="Image to crop">
        </div>
        <div class="flex justify-end space-x-2 mt-4">
            <button type="button" onclick="cancelCropping()" class="px-4 py-2 bg-gray-300 text-gray-800 rounded hover:bg-gray-400">Cancel</button>
            <button type="button" id="cropButton" class="px-4 py-2 bg-blue-600 text-white rounded hover:bg-blue-700">Crop & Use</button>
        </div>
    </div>
</div>

  <script>
    var categories = <%- JSON.stringify(categories) || '[]' %>;
    var brands = <%- JSON.stringify(brands) || '[]' %>;

    try {

 function clearErrors(form) {
            const errorSpans = form.querySelectorAll('span[id$="_error"]');
            errorSpans.forEach(span => {
                span.textContent = '';
            });
        }

        function showError(errorId, message) {
            const errorSpan = document.getElementById(errorId);
            if (errorSpan) {
                errorSpan.textContent = message;
            }
        }
        
        // Function to map server errors (e.g., "variants[0][color]") to client IDs
        function mapServerErrors(errors, mode) {
            const prefix = mode === 'add' ? 'add_' : 'edit_';
            for (const key in errors) {
                const message = errors[key];
                
                // Convert server path to client ID
                // e.g., "variants[0][color]" -> "add_variants_0_color_error"
                // e.g., "title" -> "add_title_error"
                const errorId = prefix + key.replace(/\[/g, '_').replace(/\]/g, '') + '_error';
                
                showError(errorId, message);
            }
        }


function handleToggle(event, id) {
        event.preventDefault();
        
        fetch(`/admin/products/${id}`, {
            method: 'PATCH',
        })
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                Swal.fire('Success!', data.message, 'success')
                    .then(() => window.location.reload());
            } else {
                Swal.fire('Error!', data.message, 'error');
            }
        })
        .catch(error => {
            console.error('Error:', error);
            Swal.fire('Error!', 'An unexpected error occurred.', 'error');
        });
    }
        // --- UPDATED VALIDATION FUNCTIONS ---
        // (Now use new helper functions)

        // Replace your old validateAddForm function
function validateAddForm() {
    const form = document.getElementById('addProductForm');
    clearErrors(form);
    let isValid = true;

    const title = form.querySelector('[name="title"]').value;
    const regularPrice = parseFloat(form.querySelector('[name="regular_price"]').value);
    const offerPrice = parseFloat(form.querySelector('[name="offer_price"]').value);
    
    const warrantyInput = form.querySelector('[name="warranty"]');
    const warrantyValue = warrantyInput.value;
    if (warrantyValue && warrantyValue.trim() !== '') { 
        const parsedFloat = parseFloat(warrantyValue);
        const parsedInt = parseInt(warrantyValue, 10);

        if (isNaN(parsedFloat)) {
            showError('add_warranty_error', 'Warranty must be a valid number.');
            isValid = false;
        } else if (parsedFloat !== parsedInt) {
            showError('add_warranty_error', 'Warranty must be a whole number (e.g., 6, 12).');
            isValid = false;
        } else if (parsedInt < 0) {
            showError('add_warranty_error', 'Warranty must be a non-negative number.');
            isValid = false;
        }
    }

    if (title.trim().length < 3) {
        showError('add_title_error', 'Title must be at least 3 characters long.');
        isValid = false;
    }
    if (isNaN(regularPrice) || regularPrice <= 0) {
        showError('add_regular_price_error', 'Regular Price must be a number greater than 0.');
        isValid = false;
    }
    if (offerPrice && (isNaN(offerPrice) || offerPrice <= 0)) {
        showError('add_offer_price_error', 'Offer Price must be a positive number.');
        isValid = false;
    }
    if (offerPrice && regularPrice && offerPrice >= regularPrice) {
        showError('add_offer_price_error', 'Offer Price must be less than the Regular Price.');
        isValid = false;
    }

    const variantRows = form.querySelectorAll('#variantFields .variant-row');
    if (variantRows.length === 0) {
        showError('add_variants_error', 'You must add at least one product variant.');
        isValid = false;
    }
    
    // --- FIX 2: Updated Variant Validation Loop ---
    for (let i = 0; i < variantRows.length; i++) {
        const color = variantRows[i].querySelector(`[name="variants[${i}][color]"]`).value;
        const files = variantRows[i].querySelector(`[name="variants[${i}][images]"]`).files;

        if (color.trim() === '') {
            showError(`add_variants_${i}_color_error`, 'Color is required.');
            isValid = false;
        }
        
        if (files.length < 3) {
            showError(`add_variants_${i}_images_error`, 'Each variant must have at least 3 images.');
            isValid = false;
        }

        // Nested loop to check all 3 size/quantity pairs
        let hasAtLeastOneSize = false;
        for (let j = 0; j < 3; j++) {
            const sizeInput = variantRows[i].querySelector(`[name="variants[${i}][sizes][${j}]"]`);
            const quantityInput = variantRows[i].querySelector(`[name="variants[${i}][quantities][${j}]"]`);

            const size = sizeInput.value.trim();
            const quantity = quantityInput.value.trim();

            // Logic: If one field in a pair is filled, the other must be too.
            if (size || quantity) {
                if (!size) {
                    showError(`add_variants_${i}_quantities_${j}_error`, 'Size is required if quantity is filled.');
                    isValid = false;
                }
                if (!quantity) {
                    showError(`add_variants_${i}_quantities_${j}_error`, 'Quantity is required if size is filled.');
                    isValid = false;
                }

                // Check for valid quantity
                if (quantity) {
                    const parsedQty = parseInt(quantity);
                    if (isNaN(parsedQty) || parsedQty < 0) {
                        showError(`add_variants_${i}_quantities_${j}_error`, 'Quantity must be 0 or more.');
                        isValid = false;
                    }
                }
                
                // The first size/qty pair (index 0) is mandatory
                if (j === 0) { 
                   hasAtLeastOneSize = true;
                }
            }
        } // end nested loop
        
        if (!hasAtLeastOneSize) {
            showError(`add_variants_${i}_main_error`, 'At least one size/quantity pair is required.');
            isValid = false;
        }
    } // end main variant loop
    // --- END FIX 2 ---
    
    return isValid;
}
// Replace your old validateEditForm function
function validateEditForm() {
    const form = document.getElementById('editProductForm');
    clearErrors(form);
    let isValid = true;
    
    const title = form.querySelector('[name="title"]').value;
    const regularPrice = parseFloat(form.querySelector('[name="regular_price"]').value);
    const offerPrice = parseFloat(form.querySelector('[name="offer_price"]').value);
    
    const warrantyInput = form.querySelector('[name="warranty"]');
    const warrantyValue = warrantyInput.value;
    if (warrantyValue && warrantyValue.trim() !== '') { 
        const parsedFloat = parseFloat(warrantyValue);
        const parsedInt = parseInt(warrantyValue, 10);

        if (isNaN(parsedFloat)) {
            showError('edit_warranty_error', 'Warranty must be a valid number.');
            isValid = false;
        } else if (parsedFloat !== parsedInt) {
            showError('edit_warranty_error', 'Warranty must be a whole number (e.g., 6, 12).');
            isValid = false;
        } else if (parsedInt < 0) {
            showError('edit_warranty_error', 'Warranty must be a non-negative number.');
            isValid = false;
        }
    }

    if (title.trim().length < 3) {
        showError('edit_title_error', 'Title must be at least 3 characters long.');
        isValid = false;
    }
    if (isNaN(regularPrice) || regularPrice <= 0) {
        showError('edit_regular_price_error', 'Regular Price must be a number greater than 0.');
        isValid = false;
    }
    if (offerPrice && (isNaN(offerPrice) || offerPrice <= 0)) {
        showError('edit_offer_price_error', 'Offer Price must be a positive number.');
        isValid = false;
    }
    if (offerPrice && regularPrice && offerPrice >= regularPrice) {
        showError('edit_offer_price_error', 'Offer Price must be less than the Regular Price.');
        isValid = false;
    }

    // --- FIX 2: Updated Variant Validation Loop ---
    const variantRows = form.querySelectorAll('#editVariantFields .variant-row');
    if (variantRows.length === 0) {
        showError('edit_variants_error', 'You must add at least one product variant.');
        isValid = false;
    }
    
    for (let i = 0; i < variantRows.length; i++) {
        const color = variantRows[i].querySelector(`[name="variants[${i}][color]"]`).value;

        if (color.trim() === '') {
            showError(`edit_variants_${i}_color_error`, 'Color is required.');
            isValid = false;
        }
        
        // Check total image count (existing + new)
        const existingImages = variantRows[i].querySelectorAll(`[name="variants[${i}][existing_images][]"]`).length;
        const newImageInput = variantRows[i].querySelector(`[name="variants[${i}][images]"]`);
        const newImages = newImageInput ? newImageInput.files.length : 0;
        const totalImages = existingImages + newImages;

        if (totalImages < 3) {
            showError(`edit_variants_${i}_images_error`, 'Each variant must have at least 3 images (new or existing).');
            isValid = false;
        }

        // Nested loop to check all 3 size/quantity pairs
        let hasAtLeastOneSize = false;
        for (let j = 0; j < 3; j++) {
            const sizeInput = variantRows[i].querySelector(`[name="variants[${i}][sizes][${j}]"]`);
            const quantityInput = variantRows[i].querySelector(`[name="variants[${i}][quantities][${j}]"]`);

            const size = sizeInput.value.trim();
            const quantity = quantityInput.value.trim();

            if (size || quantity) {
                if (!size) {
                    showError(`edit_variants_${i}_quantities_${j}_error`, 'Size is required if quantity is filled.');
                    isValid = false;
                }
                if (!quantity) {
                    showError(`edit_variants_${i}_quantities_${j}_error`, 'Quantity is required if size is filled.');
                    isValid = false;
                }

                if (quantity) {
                    const parsedQty = parseInt(quantity);
                    if (isNaN(parsedQty) || parsedQty < 0) {
                        showError(`edit_variants_${i}_quantities_${j}_error`, 'Quantity must be a whole numberx.');
                        isValid = false;
                    }
                }
                
                if (j === 0) {
                   hasAtLeastOneSize = true;
                }
            }
        } // end nested loop
        
        if (!hasAtLeastOneSize) {
            showError(`edit_variants_${i}_main_error`, 'At least one size/quantity pair is required.');
            isValid = false;
        }
    } // end main variant loop
    // --- END FIX 2 ---
    
    return isValid;
}

