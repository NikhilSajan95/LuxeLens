<section class="container mx-auto mt-10">
  <a href="/products">
    <img class="rounded-2xl w-full" src="/images/newBanner.jpeg" alt="Shop Sunglasses">
  </a>
</section>

<section class="py-12 px-4 sm:px-6 lg:px-8 bg-white">
  <div class="max-w-7xl mx-auto">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">

      <div class="flex flex-col items-center text-center">
        <div class="w-12 h-12 flex items-center justify-center rounded-full bg-gray-100 mb-4">
          <svg version="1.1" id="Layer_1" xmlns="http://www.w3.org/2000/svg" x="0" y="0" viewBox="0 0 64 64" style="enable-background:new 0 0 64 64" xml:space="preserve">
            <style>.st1,.st11,.st17{fill:#81d4fa;stroke:#0277bd;stroke-linecap:round;stroke-linejoin:round;stroke-miterlimit:10;}.st11,.st17{fill:#eee;}.st17{fill:none;}</style>
            <g id="Worldwide_Shipping">
              <circle class="st1" cx="32" cy="32" r="25"/>
              <path class="st17" d="M3 32C3 16 16 3 32 3M61 32c0 16-13 29-29 29M7 32h50"/>
              <ellipse class="st17" cx="32" cy="32" rx="12.5" ry="25"/>
              <path class="st1" d="M32 7v50"/>
            </g>
          </svg>
        </div>
        <h3 class="font-medium text-gray-900">Free Shipping</h3>
        <p class="mt-2 text-sm text-gray-500">On orders over ₹799. Delivery time: 3-5 business days.</p>
      </div>

      <div class="flex flex-col items-center text-center">
        <div class="w-12 h-12 flex items-center justify-center rounded-full bg-gray-100 mb-4">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 48 48">
            <rect x="6" y="6" width="40" height="28" rx="2" ry="2" style="fill:#4ac6b7"/>
            <path d="M44 6h-3a2 2 0 0 1 2 2v24a2 2 0 0 1-2 2h3a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2z" style="fill:#37b7a4"/>
            <path style="fill:#29a892" d="M6 11h40v7H6z"/>
          </svg>
        </div>
        <h3 class="font-medium text-gray-900">Satisfaction Guarantee</h3>
        <p class="mt-2 text-sm text-gray-500">Shop with confidence with our 10-day return policy.</p>
      </div>

      <div class="flex flex-col items-center text-center">
        <div class="w-12 h-12 flex items-center justify-center rounded-full bg-gray-100 mb-4">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 48 48">
            <rect x="6" y="6" width="40" height="28" rx="2" ry="2" style="fill:#4ac6b7"/>
            <path style="fill:#29a892" d="M6 11h40v7H6z"/>
            <circle cx="38" cy="26" r="3" style="fill:#ffbc5a"/>
            <circle cx="33" cy="26" r="3" style="fill:#e05555"/>
          </svg>
        </div>
        <h3 class="font-medium text-gray-900">Secure Payment</h3>
        <p class="mt-2 text-sm text-gray-500">Pay safely with our secure checkout options.</p>
      </div>

    </div>
  </div>
</section>

<section class="py-16 px-4 sm:px-6 lg:px-8 bg-white">
  <div class="max-w-7xl mx-auto">
    <div class="text-center mb-12">
      <h2 class="text-2xl font-bold text-gray-900">Best Selling</h2>
    </div>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8">
      <% if (bestSelling && bestSelling.length > 0) { %>
        <% bestSelling.forEach(item => { %>
          <a
            href="/products/<%= item.productId %>?variant=<%= item.variantId %>"
            class="group block border border-gray-100 py-3 px-3 bg-white rounded-lg overflow-hidden hover:shadow-lg transition"
          >
            <div class="bg-white rounded-lg overflow-hidden">
              <img
                src="<%= item.images && item.images[0] ? item.images[0] : '/images/no-image.png' %>"
                alt="<%= item.title %>"
                class="w-full h-64 object-contain group-hover:scale-105 transition-transform duration-300"
              />
            </div>
            <div class="mt-4">
              <h3 class="text-base text-gray-700 font-semibold"><%= item.title %></h3>
              <p class="text-sm text-gray-500"><%= item.color %> &mdash; <%= item.size %></p>
              <div class="flex items-center gap-2 mt-2">
                <span class="text-sm font-bold text-gray-900">₹<%= item.effective_price %></span>
              </div>
            </div>
          </a>
        <% }) %>
      <% } else { %>
        <p class="text-gray-500 col-span-4 text-center">No best-selling products available.</p>
      <% } %>
    </div>
  </div>
</section>

<section class="px-4 sm:px-6 lg:px-8 bg-gray-50">
  <div class="max-w-7xl mx-auto">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 items-center">
      <div>
        <h2 class="text-4xl font-bold text-gray-900">Style That Speaks Before You Do</h2>
        <p class="mt-4 text-sm text-gray-600">
          Discover our premium sunglasses — crafted for UV protection, built for every look,
          designed to turn heads wherever you go.
        </p>
        <a href="/products">
          <button class="mt-6 bg-gray-900 text-white px-6 py-2 text-sm font-medium rounded hover:bg-gray-800 transition-colors flex items-center">
            SHOP ALL
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 ml-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
            </svg>
          </button>
        </a>
      </div>
      <div class="flex justify-end">
        <img src="/images/Fitness.jpeg" alt="Lifestyle" class="h-[400px] object-cover rounded-xl"/>
      </div>
    </div>
  </div>
</section>

<section class="py-16 px-4 sm:px-6 lg:px-8 bg-white">
  <div class="max-w-7xl mx-auto">
    <div class="text-center mb-12">
      <h2 class="text-2xl font-bold text-gray-900">New Arrivals</h2>
      <p class="mt-2 text-sm text-gray-600">Fresh styles, just landed.</p>
    </div>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8">
      <% if (newArrivals && newArrivals.length > 0) { %>
        <% newArrivals.forEach(item => { %>
          <a
            href="/products/<%= item.productId %>?variant=<%= item.variantId %>"
            class="group block border border-gray-100 py-3 px-3 bg-white rounded-lg overflow-hidden hover:shadow-lg transition"
          >
            <div class="bg-white rounded-lg overflow-hidden">
              <img
                src="<%= item.images && item.images[0] ? item.images[0] : '/images/no-image.png' %>"
                alt="<%= item.title %>"
                class="w-full h-64 object-contain group-hover:scale-105 transition-transform duration-300"
              />
            </div>
            <div class="mt-4">
              <h3 class="text-base text-gray-700 font-semibold"><%= item.title %></h3>
              <p class="text-sm text-gray-500"><%= item.color %> &mdash; <%= item.size %></p>
              <div class="flex items-center gap-2 mt-2">
                <span class="text-sm font-bold text-gray-900">₹<%= item.effective_price %></span>
              </div>
            </div>
          </a>
        <% }) %>
      <% } else { %>
        <p class="text-gray-500 col-span-4 text-center">No new arrivals available.</p>
      <% } %>
    </div>
  </div>
</section>